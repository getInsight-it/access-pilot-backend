            <roles>
                <role>Arquiteto de Software</role>
            </roles>
        </developer>
        <developer>
            <id>pedro.figueiredo</id>
            <name>Pedro Henrique Ferreira Figueiredo</name>
            <email>pedro.figueiredo@getinsight.it</email>
            <url>https://gitlab.com/intellitour</url>
