<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <!-- Suppress noisy logs -->
    <logger name="org.testcontainers" level="INFO"/>
    <logger name="org.hibernate.SQL" level="INFO"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    <logger name="org.springframework.boot.test" level="INFO"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>

    <!-- Enable DEBUG for request module -->
    <logger name="it.getinsight.module.request" level="DEBUG"/>
    <logger name="it.getinsight.module.role" level="DEBUG"/>
    <logger name="it.getinsight.module.level" level="DEBUG"/>

    <!-- Test helpers -->
    <logger name="it.getinsight.core.test" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
