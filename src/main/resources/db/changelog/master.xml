<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="0001" author="pedro.figueiredo@getinsight.it">
        <createSequence sequenceName="SQ_USUARIO" minValue="1" incrementBy="1" startValue="1"/>
        <createTable tableName="TB_USUARIO">
            <column name="ID" type="INTEGER" defaultValueSequenceNext="SQ_USUARIO">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="USERNAME" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NOME" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="SOBRENOME" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ATUALIZADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_CRIACAO" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_ATUALIZACAO" type="TIMESTAMP" />
        </createTable>
        <rollback>
            <dropTable tableName="TB_USUARIO"/>
            <dropSequence sequenceName="SQ_USUARIO"/>
        </rollback>
    </changeSet>

    <changeSet id="002" author="luan.rodrigues">
        <createSequence sequenceName="SQ_CLIENTE" minValue="1" incrementBy="1" startValue="1"/>
        <createTable tableName="TB_CLIENTE">
            <column name="ID" type="BIGINT" defaultValueSequenceNext="SQ_CLIENTE">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="CLIENT_UUID" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="CLIENT_ID" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="MANAGED" type="BOOLEAN">
                <constraints nullable="true"/>
            </column>
            <column name="DESCRICAO" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="BASE_URL" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="TB_CLIENTE"/>
            <dropSequence sequenceName="SQ_CLIENTE"/>
        </rollback>
    </changeSet>


    <changeSet id="003" author="luan.rodrigues">
        <createSequence sequenceName="SQ_ROLE" minValue="1" incrementBy="1" startValue="1"/>
        <createTable tableName="TB_ROLE">
            <column name="ID" type="BIGINT" defaultValueSequenceNext="SQ_ROLE">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="ID_ROLE_EXTERNO" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NOME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRICAO" type="VARCHAR(255)"/>
            <column name="ID_ROLE_PARENT" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="ID_CLIENTE" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="FK_ROLE_ROLE" baseTableName="TB_ROLE" baseColumnNames="ID_ROLE_PARENT" referencedTableName="TB_ROLE" referencedColumnNames="ID"/>
        <addForeignKeyConstraint constraintName="FK_ROLE_CLIENTE" baseTableName="TB_ROLE" baseColumnNames="ID_CLIENTE" referencedTableName="TB_CLIENTE" referencedColumnNames="ID"/>
        <rollback>
            <dropTable tableName="TB_ROLE"/>
            <dropSequence sequenceName="SQ_ROLE"/>
        </rollback>
    </changeSet>


    <changeSet id="004" author="luan.rodrigues">
        <createSequence sequenceName="SQ_CONFIGURATION" minValue="1" incrementBy="1" startValue="1"/>
        <createTable tableName="TB_CONFIGURATION">
            <column name="ID" type="INTEGER" defaultValueSequenceNext="SQ_CONFIGURATION">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="VARCHAR(255)"/>
            <column name="ICON" type="VARCHAR(255)"/>
            <column name="AUTHORITY" type="VARCHAR(255)"/>
            <column name="REDIRECT_URL" type="VARCHAR(255)"/>
            <column name="CLIENT_ID" type="VARCHAR(255)"/>
            <column name="RESPONSE_TYPE" type="VARCHAR(255)"/>
            <column name="SCOPE" type="VARCHAR(255)"/>
            <column name="POST_LOGOUT_REDIRECT_URI" type="VARCHAR(255)"/>
            <column name="START_CHECKSESSION" type="BOOLEAN"/>
            <column name="SILENT_RENEW" type="BOOLEAN"/>
            <column name="STARTUP_ROUTE" type="VARCHAR(255)"/>
            <column name="FORBIDDEN_ROUTE" type="VARCHAR(255)"/>
            <column name="UNAUTHORIZED_ROUTE" type="VARCHAR(255)"/>
            <column name="LOG_LEVEL" type="INTEGER"/>
            <column name="MAX_ID_TOKEN_IAT_OFFSET_ALLOWED_IN_SECONDS" type="INTEGER"/>
            <column name="HISTORY_CLEANUP_OFF" type="BOOLEAN"/>
            <column name="CRIADO_POR" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ATUALIZADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_CRIACAO" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_ATUALIZACAO" type="TIMESTAMP" />
        </createTable>
        <rollback>
            <dropTable tableName="TB_CONFIGURATION"/>
            <dropSequence sequenceName="SQ_CONFIGURATION"/>
        </rollback>
    </changeSet>
