<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_052" author="luan.rodrigues@getinsight.it">
        <createTable tableName="TB_ESFERA_AUD">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="UUID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="REV" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="REVTYPE" type="SMALLINT"/>
            <column name="ID_PARENT" type="BIGINT"/>
            <column name="SIGLA" type="VARCHAR(45)"/>
            <column name="NOME" type="VARCHAR(255)"/>
            <column name="DESCRICAO" type="VARCHAR(255)"/>
            <column name="URL_EXTERNA" type="VARCHAR(255)"/>
            <column name="TIPO" type="VARCHAR(45)"/>
            <column name="ICON" type="VARCHAR(255)"/>
            <column name="API_KEY" type="VARCHAR(45)"/>
        </createTable>

        <addPrimaryKey columnNames="REV, ID" constraintName="TB_ESFERA_AUD_PKEY" tableName="TB_ESFERA_AUD"/>

        <addForeignKeyConstraint baseColumnNames="REV" baseTableName="TB_ESFERA_AUD"
                                 constraintName="FK_ESFERA_AUD_REV" referencedColumnNames="REV"
                                 referencedTableName="REVINFO"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="TB_ESFERA_AUD" constraintName="FK_ESFERA_AUD_REV"/>
            <dropTable tableName="TB_ESFERA_AUD"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
