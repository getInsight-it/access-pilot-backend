<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_094" author="luan.rodrigues@getinsight.it">
        <createSequence sequenceName="SQ_CONVITE" minValue="1" incrementBy="1" startValue="1"/>

        <createTable tableName="TB_CONVITE">
            <column name="ID" type="BIGINT" defaultValueSequenceNext="SQ_CONVITE">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="UUID" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="TOKEN_HASH" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="EMAIL" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="ID_ROLE" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="CODIGO_ITEM" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="DESCRICAO" type="VARCHAR(1000)">
                <constraints nullable="true"/>
            </column>

            <column name="STATUS" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>

            <column name="EXPIRES_AT" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>

            <column name="PROTOCOL_CODE" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>

            <column name="ID_SOLICITACAO" type="BIGINT">
                <constraints nullable="true"/>
            </column>

            <column name="CRIADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_CRIACAO" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="ATUALIZADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_ATUALIZACAO" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint constraintName="FK_CONVITE_ROLE"
                                 baseTableName="TB_CONVITE" baseColumnNames="ID_ROLE"
                                 referencedTableName="TB_ROLE" referencedColumnNames="ID"/>

        <addForeignKeyConstraint constraintName="FK_CONVITE_SOLICITACAO"
                                 baseTableName="TB_CONVITE" baseColumnNames="ID_SOLICITACAO"
                                 referencedTableName="TB_SOLICITACAO" referencedColumnNames="ID"/>

        <createIndex tableName="TB_CONVITE" indexName="IDX_CONVITE_EMAIL_STATUS">
            <column name="EMAIL"/>
            <column name="STATUS"/>
        </createIndex>

        <createIndex tableName="TB_CONVITE" indexName="IDX_CONVITE_PROTOCOL_CODE">
            <column name="PROTOCOL_CODE"/>
        </createIndex>

        <createIndex tableName="TB_CONVITE" indexName="IDX_CONVITE_EXPIRES_AT">
            <column name="EXPIRES_AT"/>
        </createIndex>

        <rollback>
            <dropTable tableName="TB_CONVITE"/>
            <dropSequence sequenceName="SQ_CONVITE"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
