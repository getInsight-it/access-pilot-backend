<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_082" author="luan.rodrigues@getinsight.it">

        <addColumn tableName="TB_SOLICITACAO">
            <column name="ESFERA_ID" type="BIGINT">
                <constraints nullable="true" />
            </column>
        </addColumn>


        <update tableName="TB_SOLICITACAO">
            <column name="ESFERA_ID"
                    valueComputed="(SELECT r.ID_ESFERA FROM TB_ROLE r WHERE r.ID = TB_SOLICITACAO.ID_ROLE)"/>
            <where>EXISTS (SELECT 1 FROM TB_ROLE r WHERE r.ID = TB_SOLICITACAO.ID_ROLE AND r.ID_ESFERA IS NOT NULL)</where>
        </update>


        <addForeignKeyConstraint baseTableName="TB_SOLICITACAO"
                                 baseColumnNames="ESFERA_ID"
                                 referencedTableName="TB_ESFERA"
                                 referencedColumnNames="ID"
                                 constraintName="FK_SOLICITACAO_ESFERA" />

        <rollback>
            <dropForeignKeyConstraint baseTableName="TB_SOLICITACAO" constraintName="FK_SOLICITACAO_ESFERA"/>
            <dropColumn tableName="TB_SOLICITACAO" columnName="ESFERA_ID"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
