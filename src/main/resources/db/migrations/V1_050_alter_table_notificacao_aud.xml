<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_050" author="luan.rodrigues@getinsight.it">

        <addColumn tableName="TB_NOTIFICACAO_AUD" >
            <column name="TITULO" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="DESCRICAO" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>


        <rollback>
            <dropColumn tableName="TB_NOTIFICACAO_AUD" columnName="TITULO"/>
            <dropColumn tableName="TB_NOTIFICACAO_AUD" columnName="DESCRICAO"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
