<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">


    <changeSet id="V1_010" author="pedro.figueiredo@getinsight.it">
        <createTable tableName="tb_cliente_aud">
            <column name="id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rev" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="revtype" type="SMALLINT"/>
            <column name="base_url" type="VARCHAR(255)"/>
            <column name="client_id" type="VARCHAR(255)"/>
            <column name="client_uuid" type="VARCHAR(255)"/>
            <column name="descricao" type="VARCHAR(255)"/>
            <column name="managed" type="BOOLEAN"/>
        </createTable>

        <addPrimaryKey columnNames="rev, id" constraintName="tb_cliente_aud_pkey" tableName="tb_cliente_aud"/>

        <addForeignKeyConstraint baseColumnNames="rev" baseTableName="tb_cliente_aud"
                                 constraintName="fkl3vfywc7ap5c734tseqwk349f" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="rev" referencedTableName="revinfo" validate="true"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="tb_cliente_aud"
                                      constraintName="fkl3vfywc7ap5c734tseqwk349f" />
            <dropTable tableName="tb_cliente_aud" />
        </rollback>

    </changeSet>

</databaseChangeLog>
