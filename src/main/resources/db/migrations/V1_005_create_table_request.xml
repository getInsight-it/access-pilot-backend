<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_005" author="luan.rodrigues@getinsight.it">
        <createSequence sequenceName="SQ_SOLICITACAO" minValue="1" incrementBy="1" startValue="1"/>

        <createTable tableName="TB_SOLICITACAO">
            <column name="ID" type="bigint" defaultValueSequenceNext="SQ_SOLICITACAO">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="STATUS" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRICAO" type="VARCHAR(255)"/>
            <column name="ID_ROLE" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="ID_USUARIO_SOLICITANTE" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="ID_USUARIO_APROVADOR" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="CRIADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_CRIACAO" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="ATUALIZADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_ATUALIZACAO" type="TIMESTAMP" />
        </createTable>

        <addForeignKeyConstraint constraintName="FK_ROLE"
                                 baseTableName="TB_SOLICITACAO" baseColumnNames="ID_ROLE"
                                 referencedTableName="TB_ROLE" referencedColumnNames="ID"/>
        <addForeignKeyConstraint constraintName="FK_USUARIO_SOLICITANTE"
                                 baseTableName="TB_SOLICITACAO" baseColumnNames="ID_USUARIO_SOLICITANTE"
                                 referencedTableName="TB_USUARIO" referencedColumnNames="ID"/>
        <addForeignKeyConstraint constraintName="FK_USUARIO_APROVADOR"
                                 baseTableName="TB_SOLICITACAO" baseColumnNames="ID_USUARIO_APROVADOR"
                                 referencedTableName="TB_USUARIO" referencedColumnNames="ID"/>

        <rollback>
            <dropTable tableName="TB_SOLICITACAO" />
            <dropForeignKeyConstraint baseTableName="TB_SOLICITACAO" constraintName="FK_ROLE" />
            <dropForeignKeyConstraint baseTableName="TB_SOLICITACAO" constraintName="FK_USUARIO_SOLICITANTE" />
            <dropForeignKeyConstraint baseTableName="TB_SOLICITACAO" constraintName="FK_USUARIO_APROVADOR" />
            <dropSequence sequenceName="SQ_SOLICITACAO" />
        </rollback>

    </changeSet>

</databaseChangeLog>
