<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_084" author="luan.rodrigues@getinsight.it">

        <addColumn tableName="TB_CONFIGURACAO_ANEXO">
            <column name="NOME" type="varchar(255)" valueComputed="initcap(replace(CHAVE, '_', ' '))">
                <constraints nullable="true"/>
            </column>
        </addColumn>


        <rollback>

            <dropColumn tableName="TB_CONFIGURACAO_ANEXO" columnName="NOME"/>

        </rollback>
    </changeSet>

</databaseChangeLog>
