<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_003" author="luan.rodrigues@getinsight.it">
        <createSequence sequenceName="SQ_ROLE" minValue="1" incrementBy="1" startValue="1"/>

        <createTable tableName="TB_ROLE">
            <column name="ID" type="BIGINT" defaultValueSequenceNext="SQ_ROLE">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="ID_ROLE_EXTERNO" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NOME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRICAO" type="VARCHAR(255)"/>
            <column name="ID_ROLE_PARENT" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="ID_CLIENTE" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="CRIADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_CRIACAO" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="ATUALIZADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_ATUALIZACAO" type="TIMESTAMP" />
        </createTable>

        <addForeignKeyConstraint constraintName="FK_ROLE_ROLE" baseTableName="TB_ROLE" baseColumnNames="ID_ROLE_PARENT" referencedTableName="TB_ROLE" referencedColumnNames="ID"/>
        <addForeignKeyConstraint constraintName="FK_ROLE_CLIENTE" baseTableName="TB_ROLE" baseColumnNames="ID_CLIENTE" referencedTableName="TB_CLIENTE" referencedColumnNames="ID"/>

        <rollback>
            <dropForeignKeyConstraint constraintName="FK_ROLE_ROLE" baseTableName="TB_ROLE" />
            <dropForeignKeyConstraint constraintName="FK_ROLE_CLIENTE" baseTableName="TB_ROLE" />
            <dropTable tableName="TB_ROLE"/>
            <dropSequence sequenceName="SQ_ROLE"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
