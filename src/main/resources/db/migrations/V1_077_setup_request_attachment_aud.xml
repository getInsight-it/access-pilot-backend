<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_077" author="luan.rodrigues@getinsight.it">

        <createTable tableName="TB_SOLICITACAO_ARQUIVO_AUD">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="UUID" type="UUID"/>

            <column name="REV" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="REVTYPE" type="SMALLINT"/>
            <column name="ID_SOLICITACAO" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="ID_ARQUIVO" type="BIGINT">
                <constraints nullable="false" />
            </column>

            <column name="ID_CONFIGURACAO" type="BIGINT">
                <constraints nullable="true" />
            </column>

            <column name="ATIVO" type="BOOLEAN"/>

            <column name="CRIADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_CRIACAO" type="TIMESTAMP"/>
            <column name="ATUALIZADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_ATUALIZACAO" type="TIMESTAMP"/>
        </createTable>

        <createSequence sequenceName="SQ_SOLICITACAO_ARQUIVO_AUD" startValue="1" incrementBy="1"/>

        <addPrimaryKey columnNames="REV, ID" constraintName="TB_SOLICITACAO_ARQUIVO_AUD_PKEY" tableName="TB_SOLICITACAO_ARQUIVO_AUD"/>


        <rollback>
            <dropTable tableName="TB_SOLICITACAO_ARQUIVO_AUD"/>
            <dropSequence sequenceName="SQ_SOLICITACAO_ARQUIVO_AUD"/>
            <dropForeignKeyConstraint baseTableName="TB_SOLICITACAO_ARQUIVO_AUD" constraintName="FK_SOLICITACAO_ARQUIVO_AUD_REV"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
