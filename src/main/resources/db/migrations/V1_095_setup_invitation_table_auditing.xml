<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_095" author="luan.rodrigues@getinsight.it">

        <createTable tableName="TB_CONVITE_AUD">
            <column name="ID" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="REV" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="REVTYPE" type="SMALLINT"/>

            <column name="UUID" type="UUID"/>
            <column name="TOKEN_HASH" type="VARCHAR(64)"/>
            <column name="EMAIL" type="VARCHAR(255)"/>
            <column name="ID_ROLE" type="BIGINT"/>
            <column name="CODIGO_ITEM" type="VARCHAR(255)"/>
            <column name="DESCRICAO" type="VARCHAR(1000)"/>
            <column name="STATUS" type="VARCHAR(32)"/>
            <column name="EXPIRES_AT" type="TIMESTAMP"/>
            <column name="PROTOCOL_CODE" type="VARCHAR(64)"/>
            <column name="ID_SOLICITACAO" type="BIGINT"/>

            <column name="CRIADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_CRIACAO" type="TIMESTAMP"/>
            <column name="ATUALIZADO_POR" type="VARCHAR(255)"/>
            <column name="DATA_ATUALIZACAO" type="TIMESTAMP"/>
        </createTable>

        <addPrimaryKey columnNames="REV, ID" constraintName="TB_CONVITE_AUD_PKEY" tableName="TB_CONVITE_AUD"/>

        <addForeignKeyConstraint baseColumnNames="REV" baseTableName="TB_CONVITE_AUD"
                                 constraintName="FK_CONVITE_AUD_REVINFO" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="REV" referencedTableName="REVINFO" validate="true"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="TB_CONVITE_AUD" constraintName="FK_CONVITE_AUD_REVINFO"/>
            <dropTable tableName="TB_CONVITE_AUD"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
