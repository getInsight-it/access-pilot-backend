<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="V1_012" author="pedro.figueiredo@getinsight.it">
        <createTable tableName="tb_email_sent_aud">
            <column name="email_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rev" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="revtype" type="SMALLINT"/>
            <column name="anonymous_copy" type="VARCHAR(255)"/>
            <column name="app_name" type="VARCHAR(255)"/>
            <column name="attachment_id" type="UUID"/>
            <column name="content" type="VARCHAR(1000)"/>
            <column name="copy" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="email_from" type="VARCHAR(255)"/>
            <column name="html_flag" type="BOOLEAN"/>
            <column name="subject" type="VARCHAR(255)"/>
            <column name="success_flg" type="BOOLEAN"/>
            <column name="email_to" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
        </createTable>

        <addPrimaryKey columnNames="rev, email_id" constraintName="tb_email_sent_aud_pkey"
                       tableName="tb_email_sent_aud"/>

        <addForeignKeyConstraint baseColumnNames="rev" baseTableName="tb_email_sent_aud"
                                 constraintName="fk5imdnmabw5ja23d60pfm12v85" deferrable="false"
                                 initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION"
                                 referencedColumnNames="rev" referencedTableName="revinfo" validate="true"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="tb_email_sent_aud"
                                      constraintName="fk5imdnmabw5ja23d60pfm12v85" />

            <dropTable tableName="tb_email_sent_aud" />
        </rollback>

    </changeSet>


</databaseChangeLog>
